# ── Required ──────────────────────────────────────────────────────────────
# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=

# openssl rand -hex 32
PAYLOAD_SECRET=

# Public origin. Used for CORS/CSRF, sitemap and preview URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=New site

# ── Media: Cloudflare R2 ──────────────────────────────────────────────────
# Leave S3_BUCKET blank to store uploads on local disk instead (dev only).
# The bucket needs CORS PUT from this site's origin — uploads go straight
# from the browser to R2, bypassing Vercel's 4.5MB function body limit.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# ── Optional: leave any of these blank to disable the feature ─────────────

# Transactional email (contact form notifications, password resets)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Analytics — the shared wlabs Umami instance
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Form spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Error tracking
SENTRY_DSN=

# Cron + on-demand revalidation. Both fail CLOSED: unset means the endpoints
# reject every request rather than being publicly callable.
CRON_SECRET=
REVALIDATE_SECRET=

# SSO — dormant unless all three are set (Enterprise tier only)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Seed defaults
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
